<UserControl
    x:Class="ToggleButton.ToggleButtonControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ToggleButton"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="control"
    d:DesignHeight="50"
    d:DesignWidth="150"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:HalfOfConverter x:Key="halfOfConverter" />
    </UserControl.Resources>
    <Grid>
        <Border
            Width="{Binding ElementName=control, Path=Width}"
            Height="{Binding ElementName=control, Path=Height}"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="{Binding ElementName=control, Path=Height, Converter={StaticResource halfOfConverter}}" />

        <Border
            Width="{Binding ElementName=control, Path=Height}"
            Height="{Binding ElementName=control, Path=Height}"
            Background="DarkGray"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="{Binding ElementName=control, Path=Height, Converter={StaticResource halfOfConverter}}" />
    </Grid>
</UserControl>
